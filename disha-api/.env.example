# Copy to .env and fill in
# MySQL (the company's server, or local). Create the database and user first:  mysql -u root -p < sql/schema.sql
DATABASE_URL=mysql+pymysql://disha:CHANGE-THIS-PASSWORD@localhost:3306/disha?charset=utf8mb4
# Laptop testing only, when no MySQL is available yet: a throwaway file instead (never on a server)
# DATABASE_URL=sqlite:///./local-test.db
# ALLOW_LOCAL_TEST_DB=true
# ---- Model provider: anthropic | groq | ollama | openai ----
LLM_PROVIDER=groq
# LLM_MODE=single  -> every message goes to LLM_PROVIDER
# LLM_MODE=hybrid  -> simple questions to HYBRID_BASIC_PROVIDER (cheap/local), complex ones to HYBRID_COMPLEX_PROVIDER;
#                     if the basic model fails, the same message is retried on the complex one
LLM_MODE=single
HYBRID_BASIC_PROVIDER=ollama
HYBRID_COMPLEX_PROVIDER=anthropic
# The demo page's "server model" dropdown switches these live (until restart).
# Seconds to wait on a short rate limit before falling back / saying "one moment"
LLM_MAX_RATE_WAIT_SECONDS=3

# Groq (free tier at console.groq.com; tool-calling models on the free plan)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
# Second Groq model used when GROQ_MODEL hits its per-minute limit (must exist on your account; empty = none)
GROQ_FALLBACK_MODEL=
# alternatives: llama-3.1-8b-instant (faster, smaller), meta-llama/llama-4-scout-17b-16e-instruct

# Ollama (local, no key): `ollama pull qwen3:8b` (or qwen3:4b for speed; llama3.1:8b also works)
# Ollama starts by itself on Windows; check with: curl.exe http://localhost:11434/v1/models
# On a CPU-only laptop one reply can take minutes; raise this if you see ReadTimeout
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Anthropic (paid credits)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# OpenAI (paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Meta WhatsApp Cloud API (WA_TOKEN empty = dry-run: messages are logged in the console, not sent)
WA_TOKEN=
WA_PHONE_NUMBER_ID=1234567890
WA_VERIFY_TOKEN=any-random-string-you-choose
WA_TEMPLATE_CONFIRM=booking_confirmed
WA_TEMPLATE_REMINDER=appointment_reminder

# Retell custom-function webhook secret (any string; Retell sends it as X-Retell-Secret)
RETELL_SECRET=change-me
# "Talk to Disha AI" voice page (http://localhost:8000/disha/): starts Retell web calls from the browser.
# API key: Retell dashboard -> API Keys (stays on the server, never sent to the page).
# Agent: the agent's id (agent_...) or simply paste its link - the id is read from it.
RETELL_API_KEY=
RETELL_AGENT_ID=
# Max voice calls a single device can start per minute (each call uses Retell minutes)
VOICE_CALLS_PER_MINUTE=5
# On calls, if an answer takes longer than this many seconds Disha first says "One moment, let me check that for you."
# (0 = never)
CALL_CHECKING_SECONDS=1.5
# ---- Phone line (Indian number in front of Retell) ----
# Import both numbers into Retell (Phone Numbers -> SIP trunking) and attach the same agent: incoming calls work on both.
# PHONE_PROVIDER = the line Disha calls OUT from (plivo | exotel). Switch live: PUT /phone/line {"provider":"exotel"}
PHONE_PROVIDER=plivo
PLIVO_NUMBER=
EXOTEL_NUMBER=
OUTBOUND_CALLS_PER_HOUR=30
# ---- DhishaAI Admin Portal (the Node LMS): leads, bookings and callbacks become Enquiries there ----
# Make a user for Disha in the portal (Settings -> Users, role counsellor) and put its sign-in here. Empty = off.
LMS_URL=http://127.0.0.1:4000
LMS_EMAIL=
LMS_PASSWORD=
# Console API key: bearer token for the data endpoints (/console/*: tables, CSV, counsellor replies) and the
# counsellor test page
CONSOLE_TOKEN=change-me-too

# ---- Website knowledge (automatic) ----
# Disha reads WEBSITE_URL on start and every WEBSITE_REFRESH_HOURS: every page in the site's sitemap, plus WEBSITE_PAGES.
# New or changed pages on the website reach Disha at the next refresh (or at once: dashboard -> Website knowledge).
WEBSITE_URL=https://dhishaai.com
WEBSITE_REFRESH_ENABLED=true
WEBSITE_REFRESH_HOURS=6
WEBSITE_MAX_PAGES=80
# WEBSITE_PAGES=/,/about-us/,/services/,/learning-development/,/product-development/,/project-consulting/,/resource-management/,/industries/,/products/,/careers/,/testimonials/,/insights/,/contact/

# ---- Website / WordPress ----
# Shared secret the website front end (PHP / WordPress plugin) sends as X-Site-Key on /web/chat; also used by
# the test chat page
SITE_KEY=change-me-site-key
# Lock browsers to your site(s); * only for local testing
ALLOWED_ORIGINS=*
# Your WordPress site; when set, courses are read from its `course` post type every WP_SYNC_MINUTES
WP_BASE_URL=
WP_SYNC_MINUTES=10
WEB_RATE_LIMIT_PER_MINUTE=20

OFFICE_ADDRESS=Arya Hub Mall, Prashanth Extension, Whitefield, Bengaluru 560066
OFFICE_HOURS=9:30 AM to 7:00 PM, Mon to Sat
OFFICE_PHONE=+91 98860 96090
OFFICE_EMAIL=contactus@dhishaai.com
TZ=Asia/Kolkata
